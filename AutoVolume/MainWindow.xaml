<Window x:Class="AutoVolume.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoVolume 音量闪避"
        Width="1020" Height="720" MinWidth="940" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3"
        FontFamily="Microsoft YaHei UI" FontSize="15"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="0,0,0,1" Padding="24,18">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AutoVolume" FontSize="23" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="音量自动闪避" FontSize="15" Margin="12,0,0,3"
                               VerticalAlignment="Bottom" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="RunPill" Style="{StaticResource Pill}" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock x:Name="RunPillText" FontSize="13.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <Button x:Name="ToggleButton" Style="{StaticResource PrimaryButton}"
                            MinWidth="132" Click="ToggleButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,18,20,10">
            <StackPanel>

                <TextBlock Text="触发源" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel x:Name="TriggerPanel" />

                        <Border Background="#FAFAFA" CornerRadius="8" Padding="14,10" Margin="0,8,0,0">
                            <DockPanel>
                                <TextBlock Text="酷狗暂停热键" Style="{StaticResource FieldLabel}" DockPanel.Dock="Left" />
                                <TextBox x:Name="HotkeyBox" Style="{StaticResource NumberBox}" Width="180"
                                         HorizontalAlignment="Right" />
                            </DockPanel>
                        </Border>

                        <Border Background="#FAFAFA" CornerRadius="8" Padding="14,10" Margin="0,8,0,0">
                            <DockPanel>
                                <TextBlock Text="电平刷新间隔" Style="{StaticResource FieldLabel}" DockPanel.Dock="Left" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox x:Name="RefreshBox" Style="{StaticResource NumberBox}" Width="90" />
                                    <TextBlock Text="ms" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                               Margin="8,0,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock x:Name="TriggerHint" Style="{StaticResource Caption}" Margin="2,12,0,0"
                                   TextWrapping="Wrap"
                                   Text="持续 = 电平需要连续超过阈值多久才算触发；保持 = 电平掉下去后继续维持触发多久才解除。" />
                    </StackPanel>
                </Border>

                <TextBlock Text="目标" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <StackPanel x:Name="TargetPanel" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- footer -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <TextBlock x:Name="PathText" VerticalAlignment="Center" Style="{StaticResource Caption}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                <Button Content="打开程序目录" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                        Click="OpenFolder_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>