<Window x:Class="AutoVolume.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoVolume 音量闪避"
        Width="1020" Height="720" MinWidth="940" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="15"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="0,0,0,1" Padding="24,18">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AutoVolume" FontSize="23" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="音量自动闪避" FontSize="15" Margin="12,0,0,3"
                               VerticalAlignment="Bottom" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="VersionText" FontSize="13.5" Margin="10,0,0,5"
                               VerticalAlignment="Bottom" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ThemeButton" Style="{StaticResource GhostButton}" Margin="0,0,12,0"
                            Click="ThemeButton_Click" />
                    <Border x:Name="RunPill" Style="{StaticResource Pill}" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock x:Name="RunPillText" FontSize="13.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <Button x:Name="ToggleButton" Style="{StaticResource PrimaryButton}"
                            MinWidth="132" Click="ToggleButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- content -->
        <ScrollViewer x:Name="RootScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,18,20,10">
            <StackPanel>

                <TextBlock Text="触发源" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel x:Name="TriggerPanel" />

                        <Border Background="{DynamicResource ChipBrush}" CornerRadius="8" Padding="14,10" Margin="0,8,0,0">
                            <DockPanel>
                                <TextBlock Text="酷狗暂停热键" Style="{StaticResource FieldLabel}" DockPanel.Dock="Left" />
                                <TextBox x:Name="HotkeyBox" Style="{StaticResource NumberBox}" Width="180"
                                         HorizontalAlignment="Right" />
                            </DockPanel>
                        </Border>

                        <Border Background="{DynamicResource ChipBrush}" CornerRadius="8" Padding="14,10" Margin="0,8,0,0">
                            <DockPanel>
                                <TextBlock Text="电平刷新间隔" Style="{StaticResource FieldLabel}" DockPanel.Dock="Left" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox x:Name="RefreshBox" Style="{StaticResource NumberBox}" Width="90" />
                                    <TextBlock Text="ms" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                               Margin="8,0,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock x:Name="TriggerHint" Style="{StaticResource Caption}" Margin="2,12,0,0"
                                   TextWrapping="Wrap"
                                   Text="麦克风按“是否被其他程序占用”触发（如豆包语音输入），与音量大小无关；视频按电平触发。持续 = 需要维持多久才算触发；保持 = 结束后继续维持多久才解除。" />
                    </StackPanel>
                </Border>

                <TextBlock Text="目标" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <StackPanel x:Name="TargetPanel" />
                </Border>

                <TextBlock Text="忽略的麦克风占用" Style="{StaticResource SectionTitle}" Margin="2,8,0,10" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="IgnoredBox" Style="{StaticResource ProcessBox}"
                                     VerticalAlignment="Center" />
                            <CheckBox x:Name="ShowSystemIgnored" Grid.Column="2" Style="{StaticResource Switch}"
                                      Content="显示内置系统进程" FontSize="13.5" Margin="0,0,16,0"
                                      VerticalAlignment="Center"
                                      Checked="ShowSystemIgnored_Changed" Unchecked="ShowSystemIgnored_Changed" />
                            <Button Grid.Column="3" Content="添加" Style="{StaticResource GhostButton}"
                                    Click="AddIgnored_Click" />
                        </Grid>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   Text="列出的程序占用麦克风时不会触发闪避。进程名可在任务管理器「详细信息」页查看，填 KuGou 或 KuGou.exe 均可。内置系统进程始终会被忽略，可用开关查看。" />
                        <WrapPanel x:Name="IgnoredPanel" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- footer -->
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <TextBlock x:Name="PathText" VerticalAlignment="Center" Style="{StaticResource Caption}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                <Button Content="打开程序目录" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                        Click="OpenFolder_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>