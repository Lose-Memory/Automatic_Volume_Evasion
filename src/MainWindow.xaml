<Window x:Class="AutoVolume.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AutoVolume"
        Title="AutoVolume 音量闪避"
        Width="1020" Height="720" MinWidth="940" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        FontSize="15"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Height="64" Padding="24,0"
                BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AutoVolume" FontSize="21" FontWeight="SemiBold" />
                    <Border Width="1" Height="15" Margin="14,0" VerticalAlignment="Center"
                            Background="{DynamicResource RuleBrush}" />
                    <TextBlock Text="音量自动闪避" FontSize="14" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="VersionText" FontSize="12.5" Margin="10,1,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFaintBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ThemeButton" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                            Click="ThemeButton_Click" />
                    <Border x:Name="RunPill" Style="{StaticResource Pill}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="RunDot" Width="6" Height="6" VerticalAlignment="Center" />
                            <TextBlock x:Name="RunPillText" FontSize="13" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="ToggleButton" Style="{StaticResource MainButton}"
                            MinWidth="124" Click="ToggleButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- content -->
        <ScrollViewer x:Name="RootScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,14,24,6">
            <StackPanel>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="触发源" Style="{StaticResource SectionLabel}" />
                    <Border Grid.Column="1" Height="1" Margin="14,0" VerticalAlignment="Center"
                            Background="{DynamicResource RuleBrush}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="电平刷新" Style="{StaticResource ParamLabel}" VerticalAlignment="Center" />
                        <TextBox x:Name="RefreshBox" Style="{StaticResource NumberBox}" Width="62" Height="26"
                                 Margin="8,0,5,0" />
                        <TextBlock Text="ms" Style="{StaticResource ParamUnit}" VerticalAlignment="Center" />
                        <TextBlock Text="麦克风扫描" Style="{StaticResource ParamLabel}" Margin="18,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="ScanBox" Style="{StaticResource NumberBox}" Width="62" Height="26"
                                 Margin="8,0,5,0" />
                        <TextBlock Text="ms" Style="{StaticResource ParamUnit}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="344" />
                            </Grid.ColumnDefinitions>

                            <CheckBox x:Name="MicSwitch" Style="{StaticResource Switch}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="麦克风" Style="{StaticResource RowTitle}" />
                            <local:SegmentedMeter x:Name="MicMeter" Grid.Column="2" Height="14" Margin="0,0,16,0"
                                                  VerticalAlignment="Center"
                                                  FillBrush="{DynamicResource MeterIdleBrush}"
                                                  EmptyBrush="{DynamicResource MeterTrackBrush}" />
                            <TextBlock x:Name="MicReadout" Grid.Column="3" Style="{StaticResource Readout}"
                                       HorizontalAlignment="Stretch" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="12,0,0,0">
                                <TextBlock Text="持续" Style="{StaticResource ParamLabel}" VerticalAlignment="Center" />
                                <TextBox x:Name="MicSustainBox" Style="{StaticResource NumberBox}"
                                         Margin="6,0,4,0" />
                                <TextBlock Text="ms" Style="{StaticResource ParamUnit}" VerticalAlignment="Center" />
                                <TextBlock Text="保持" Style="{StaticResource ParamLabel}" Margin="14,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="MicHoldBox" Style="{StaticResource NumberBox}"
                                         Margin="6,0,4,0" />
                                <TextBlock Text="ms" Style="{StaticResource ParamUnit}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource RuleBrush}" Margin="0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="344" />
                            </Grid.ColumnDefinitions>

                            <CheckBox x:Name="VideoSwitch" Style="{StaticResource Switch}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="视频播放" Style="{StaticResource RowTitle}" />
                            <local:SegmentedMeter x:Name="VideoMeter" Grid.Column="2" Height="14" Margin="0,0,16,0"
                                                  VerticalAlignment="Center"
                                                  FillBrush="{DynamicResource MeterIdleBrush}"
                                                  EmptyBrush="{DynamicResource MeterTrackBrush}"
                                                  MarkerBrush="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="VideoReadout" Grid.Column="3" Style="{StaticResource Readout}"
                                       HorizontalAlignment="Right" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="12,0,0,0">
                                <TextBlock Text="阈值" Style="{StaticResource ParamLabel}" VerticalAlignment="Center" />
                                <TextBox x:Name="VideoThresholdBox" Style="{StaticResource NumberBox}"
                                         Margin="6,0,4,0" />
                                <TextBlock Text="dB" Style="{StaticResource ParamUnit}" VerticalAlignment="Center" />
                                <TextBlock Text="持续" Style="{StaticResource ParamLabel}" Margin="14,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="VideoSustainBox" Style="{StaticResource NumberBox}"
                                         Margin="6,0,4,0" />
                                <TextBlock Text="ms" Style="{StaticResource ParamUnit}" VerticalAlignment="Center" />
                                <TextBlock Text="保持" Style="{StaticResource ParamLabel}" Margin="14,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="VideoHoldBox" Style="{StaticResource NumberBox}"
                                         Margin="6,0,4,0" />
                                <TextBlock Text="ms" Style="{StaticResource ParamUnit}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource RuleBrush}" Margin="0,10,0,9" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="麦克风按占用触发，视频按电平触发。持续 = 维持多久才触发；保持 = 结束后继续多久才解除。" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="音乐程序" Style="{StaticResource SectionLabel}" />
                    <Border Grid.Column="1" Height="1" Margin="14,0" VerticalAlignment="Center"
                            Background="{DynamicResource RuleBrush}" />
                    <StackPanel x:Name="MusicFilter" Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" />
                </Grid>

                <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel x:Name="MusicTargetPanel" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="MusicProgramCombo" Style="{StaticResource ActionCombo}" Width="Auto"
                                      VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="添加" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Click="AddMusicFromCombo_Click" />
                            <TextBox x:Name="MusicManualBox" Grid.Column="3" Style="{StaticResource HintBox}"
                                     Tag="手动输入进程名，例如 KuGou" />
                            <Button Grid.Column="4" Content="添加" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Click="AddMusicFromText_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="视频程序" Style="{StaticResource SectionLabel}" />
                    <Border Grid.Column="1" Height="1" Margin="14,0" VerticalAlignment="Center"
                            Background="{DynamicResource RuleBrush}" />
                    <StackPanel x:Name="VideoFilter" Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" />
                </Grid>

                <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel x:Name="VideoTargetPanel" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="VideoProgramCombo" Style="{StaticResource ActionCombo}" Width="Auto"
                                      VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="添加" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Click="AddVideoFromCombo_Click" />
                            <TextBox x:Name="VideoManualBox" Grid.Column="3" Style="{StaticResource HintBox}"
                                     Tag="手动输入进程名，例如 PotPlayerMini64" />
                            <Button Grid.Column="4" Content="添加" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Click="AddVideoFromText_Click" />
                        </Grid>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   Text="视频程序本身也是触发源：其中任一程序输出音频时，音乐程序会被压低。" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="忽略的麦克风占用" Style="{StaticResource SectionLabel}" />
                    <Border Grid.Column="1" Height="1" Margin="14,0" VerticalAlignment="Center"
                            Background="{DynamicResource RuleBrush}" />
                    <CheckBox x:Name="ShowSystemIgnored" Grid.Column="2" Style="{StaticResource Switch}"
                              Content="显示内置系统进程" FontSize="13.5"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              Checked="ShowSystemIgnored_Changed" Unchecked="ShowSystemIgnored_Changed" />
                </Grid>

                <Border Style="{StaticResource Panel}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="IgnoredBox" Style="{StaticResource NumberBox}" Width="240"
                                 HorizontalContentAlignment="Left" />
                        <Button Grid.Column="1" Content="添加" Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" Click="AddIgnored_Click" />
                        <WrapPanel x:Name="IgnoredPanel" Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- footer -->
        <Border Grid.Row="2" Height="40" Padding="24,0"
                BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="PathText" Style="{StaticResource Caption}" FontSize="12.5"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"
                           Foreground="{DynamicResource TextFaintBrush}" />
                <Button Content="打开程序目录" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenFolder_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>